#!/bin/bash
# "Agent Chrome": the installed Google Chrome under this install's own macOS app identity, for the agent browsers.
#
# Why: a Chrome launched from Google Chrome.app, even headless on another profile, registers with macOS as
# "Google Chrome". While it runs, clicking Chrome in the Dock activates that windowless agent process instead of
# starting the user's Chrome, and Quit targets it too.
# Fix: an APFS clone of Google Chrome.app (same binary, version, UA and client hints, so websites see plain Chrome)
# with bundle id HB_BUNDLE_ID, ad-hoc re-signed. Not Chrome for Testing: sites treat it differently.
#
#   agent-chrome               rebuild the clone if Google Chrome's version changed, print the executable
#   agent-chrome --no-update   print the installed executable only (exit 1 if none)
#   agent-chrome --print-app   print the installed app bundle path (exit 1 if none)
#   agent-chrome refresh       (launchd, periodic) rebuild if needed; restart this install's browser servers onto
#                              it once no Chrome of this install (matched by bundle id) is running
#
# Stable path for consumers (serve, pw-identity login, plain-chrome):
#   $HB_STATE_DIR/agent-chrome/current/Agent Chrome.app/Contents/MacOS/Google Chrome
# Never falls back to Google Chrome.app itself: that brings the collision back.
set -euo pipefail
# shellcheck source=lib/config.sh
source "$(dirname "$0")/lib/config.sh"
SRC=$HB_CHROME_APP
ROOT=$HB_STATE_DIR/agent-chrome
APP_REL="Agent Chrome.app"
EXE_REL="$APP_REL/Contents/MacOS/Google Chrome"
EXE="$ROOT/current/$EXE_REL"
ID=$HB_BUNDLE_ID

installed() { # print the installed executable (or app) and stop
  [ -x "$EXE" ] || { echo "agent-chrome: no Agent Chrome in $ROOT" >&2; exit 1; }
  if [ "${1:-}" = app ]; then echo "$ROOT/current/$APP_REL"; else echo "$EXE"; fi
  exit 0
}
[ "${1:-}" = --no-update ] && installed
[ "${1:-}" = --print-app ] && installed app

mkdir -p "$ROOT"
# Every server starts together under launchd: one builder at a time.
[ -z "${AGENT_CHROME_LOCKED:-}" ] && AGENT_CHROME_LOCKED=1 exec /usr/bin/lockf -t 900 "$ROOT/.lock" "$0" "$@"

build() { # $1 = version; clone + re-identify + re-sign into $ROOT/$1. Run it in a subshell (below): set -e must hold.
  local ver="$1" tmp app fw
  tmp="$(mktemp -d "$ROOT/.build.XXXX")"
  # shellcheck disable=SC2064  # expand now: the trap runs after the function (and its locals) ended
  trap "rm -rf '$tmp'" EXIT   # a failed build leaves nothing behind (after the mv below, $tmp is gone)
  app="$tmp/$APP_REL"
  fw="$app/Contents/Frameworks/Google Chrome Framework.framework/Versions"
  cp -Rc "$SRC" "$app"
  # Chrome keeps the previous framework versions around after an update; they fail re-signing.
  find "$fw" -mindepth 1 -maxdepth 1 -type d ! -name "$ver" -exec rm -rf {} +
  find "$fw/$ver/Helpers" -mindepth 1 -maxdepth 1 -name 'GoogleUpdater.app' -exec rm -rf {} +
  /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $ID" -c "Set :CFBundleName Agent Chrome" \
    -c "Delete :KSProductID" "$app/Contents/Info.plist" 2>/dev/null || true
  /usr/libexec/PlistBuddy -c "Set :CFBundleDisplayName Agent Chrome" "$app/Contents/Info.plist" 2>/dev/null || true
  xattr -cr "$app"
  codesign --force --deep --sign - "$app" >/dev/null 2>&1
  codesign --verify --deep "$app"
  # The first launch of a freshly signed bundle can deadlock while macOS assesses it; take it here, not in a server.
  local warm pid guard
  warm="$(mktemp -d)"
  "$app/Contents/MacOS/Google Chrome" --headless --user-data-dir="$warm" --use-mock-keychain --no-first-run \
    --dump-dom about:blank >/dev/null 2>&1 &
  pid=$!
  (sleep 60; kill -9 "$pid" 2>/dev/null) >/dev/null 2>&1 &   # off our stdout: a caller's $(…) must not wait 60 s
  guard=$!
  wait "$pid" 2>/dev/null || true
  { kill "$guard"; wait "$guard"; } 2>/dev/null || true
  pkill -9 -f "user-data-dir=$warm" 2>/dev/null || true
  rm -rf "${warm:?}"
  rm -rf "${ROOT:?}/${ver:?}"
  mv "$tmp" "$ROOT/$ver"
}

[ -d "$SRC" ] || { echo "agent-chrome: no Google Chrome at $SRC (HB_CHROME_APP)" >&2; [ -x "$EXE" ] && installed; exit 1; }
ver="$(/usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" "$SRC/Contents/Info.plist")"
before="$(readlink "$ROOT/current" 2>/dev/null || true)"
if [ ! -x "$ROOT/$ver/$EXE_REL" ]; then
  # Not `build || …`: bash turns set -e off inside anything left of `||`, so a failed codesign would still install.
  set +e; (set -e; build "$ver"); rc=$?; set -e
  [ "$rc" = 0 ] || { echo "agent-chrome: build of $ver failed, keeping the installed one" >&2; installed; }
fi
if [ "$before" != "$ver" ]; then
  ln -sfn "$ver" "$ROOT/current.tmp" && mv -fh "$ROOT/current.tmp" "$ROOT/current"
fi

# Keep the two newest builds, the new one and the one in use before (a refresh may point current back at it).
/usr/bin/python3 - "$ROOT" "$ver" "$before" <<'PY'
import re, shutil, sys
from pathlib import Path
root, keep = Path(sys.argv[1]), set(sys.argv[2:])
vers = sorted((p for p in root.iterdir() if re.fullmatch(r"[\d.]+", p.name)),
              key=lambda p: tuple(map(int, p.name.split("."))))
for p in vers[:-2]:
    if p.name not in keep:
        shutil.rmtree(p)
PY

# own_chrome_running: a Chrome main process whose app bundle carries this install's bundle id (never another
# install's Agent Chrome, never the user's Google Chrome).
own_chrome_running() {
  /usr/bin/python3 - "$ID" <<'PY'
import plistlib, re, subprocess, sys
want = sys.argv[1]
out = subprocess.run(["ps", "-axo", "command="], capture_output=True, text=True).stdout
for cmd in out.splitlines():
    m = re.match(r"(.+?\.app)/Contents/MacOS/Google Chrome(\s|$)", cmd)
    if not m or "--type=" in cmd:
        continue
    try:
        with open(m.group(1) + "/Contents/Info.plist", "rb") as f:
            if plistlib.load(f).get("CFBundleIdentifier") == want:
                sys.exit(0)
    except OSError:
        pass
sys.exit(1)
PY
}

if [ "${1:-}" = refresh ] && [ "$before" != "$ver" ] && [ -n "$before" ]; then
  if own_chrome_running; then
    echo "agent-chrome: built $ver; servers still on $before (an agent Chrome of this install is running), retry next refresh" >&2
    ln -sfn "$before" "$ROOT/current"   # stay put until the servers can move together
  else
    for name in $(/usr/bin/python3 "$HB_HOME/lib/hbconfig.py" ports | awk '{print $1}'); do
      launchctl kickstart -k "gui/$(id -u)/$HB_LABEL_PREFIX.$name" 2>/dev/null || true
    done
  fi
fi
echo "$EXE"
