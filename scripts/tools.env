# Pinned build/test tools (scripts/tools.sh; CI uses the same). macOS arm64 only. One line per tool:
# <TOOL>_VERSION, <TOOL>_URL (the release asset), <TOOL>_SHA256 (of that asset), <TOOL>_BIN (path inside the archive).
GITLEAKS_VERSION=8.30.1
GITLEAKS_URL=https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_darwin_arm64.tar.gz
GITLEAKS_SHA256=b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5
GITLEAKS_BIN=gitleaks

SHELLCHECK_VERSION=0.11.0
SHELLCHECK_URL=https://github.com/koalaman/shellcheck/releases/download/v0.11.0/shellcheck-v0.11.0.darwin.aarch64.tar.xz
SHELLCHECK_SHA256=56affdd8de5527894dca6dc3d7e0a99a873b0f004d7aabc30ae407d3f48b0a79
SHELLCHECK_BIN=shellcheck-v0.11.0/shellcheck

# Tart: FSL licence (test use allowed). TART_HOME stays at its default, so an image pulled with this version is reused.
TART_VERSION=2.42.0
TART_URL=https://github.com/openai/tart/releases/download/2.42.0/tart.tar.gz
TART_SHA256=a95dda214b5f676298430d665a8174992e6b300dd20c653385b60481ae819ddf
TART_BIN=tart.app/Contents/MacOS/tart

GORELEASER_VERSION=2.20.2
GORELEASER_URL=https://github.com/goreleaser/goreleaser/releases/download/v2.20.2/goreleaser_Darwin_arm64.tar.gz
GORELEASER_SHA256=4e68482f6bbdb2d3ce7f835be50a4eb7287ee999cefc563c49c5f42ad3778c78
GORELEASER_BIN=goreleaser
