#!/bin/sh
# App pre-push hook (installed as app/.githooks/pre-push, `git config core.hooksPath .githooks`; every
# workslot shares it). 1) main changes only by merging a green PR (build workspace lanes/flows/full.md § ship):
# GitHub cannot enforce this on a free private repo. 2) Only when the build workspace has a leak gate
# (ops/leak-scan.sh): every blob the push sends is scanned by it; a hit refuses the push. The scan prints
# file:line + pattern index only, never the text.
ws=${CREW_WORKSPACE:-}
if [ -z "$ws" ]; then
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=
  ws=$(dirname "$(dirname "$common")")   # <workspace>/app/.git -> <workspace>
fi
scanner=$ws/ops/leak-scan.sh
rc=0
while read -r _ local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct push to main refused. Push a branch, open a PR, merge it when CI is green." >&2
    exit 1
  fi
  case $local_sha in *[!0]*) ;; *) continue ;; esac   # a delete sends nothing
  [ -e "$scanner" ] || continue   # no leak gate in this workspace
  if [ ! -x "$scanner" ]; then
    echo "pre-push: leak scanner at $scanner is not executable; refusing." >&2
    exit 1
  fi
  "$scanner" --push "$local_sha" "$remote_sha" . || rc=1
done
if [ $rc != 0 ]; then
  echo "pre-push: refused. Replace the real data with synthetic values; a false positive goes to the overseer as #N." >&2
fi
exit $rc
