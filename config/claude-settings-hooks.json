{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(plugin_hommy-browsers_)?identity(-[a-d])?__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/share/hommy-browsers/pw-identity hook pre",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__(plugin_hommy-browsers_)?identity(-[a-d])?__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/share/hommy-browsers/pw-identity hook post",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__(plugin_hommy-browsers_)?identity(-[a-d])?__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/share/hommy-browsers/pw-identity hook post",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
